{
    "model": "sonnet",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/Users/admin/.claude/hooks/rtk-rewrite.sh"
                    }
                ]
            },
            {
                "matcher": "Grep|Glob",
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/hooks/cbm-code-discovery-gate",
                        "timeout": 5
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"/Users/admin/.claude/hooks/context-mode-cache-heal.mjs\""
                    }
                ]
            },
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/hooks/cbm-session-reminder"
                    }
                ]
            },
            {
                "matcher": "resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/hooks/cbm-session-reminder"
                    }
                ]
            },
            {
                "matcher": "clear",
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/hooks/cbm-session-reminder"
                    }
                ]
            },
            {
                "matcher": "compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/hooks/cbm-session-reminder"
                    }
                ]
            }
        ]
    },
    "enabledPlugins": {
        "superpowers@claude-plugins-official": true,
        "context-mode@context-mode": true,
        "rust-analyzer-lsp@claude-plugins-official": true,
        "caveman@caveman": true
    },
    "extraKnownMarketplaces": {
        "context-mode": {
            "source": {
                "source": "github",
                "repo": "mksglu/context-mode"
            }
        },
        "caveman": {
            "source": {
                "source": "github",
                "repo": "JuliusBrussee/caveman"
            }
        }
    },
    "effortLevel": "medium",
    "tui": "fullscreen",
    "skipWorkflowUsageWarning": true,
    "skipAutoPermissionPrompt": true
}
